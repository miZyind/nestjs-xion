{
  "name": "nestjs-xion",
  "version": "0.0.0-development",
  "description": "Excogitative integration of NestJS",
  "repository": "git@github.com:miZyind/nestjs-xion.git",
  "author": "miZyind <mizyind.dev>",
  "license": "MIT",
  "homepage": "https://github.com/miZyind/nestjs-xion#readme",
  "bugs": "https://github.com/miZyind/nestjs-xion/issues",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --max-warnings 0",
    "semantic-release": "semantic-release"
  },
  "engines": {
    "node": ">=22",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "eslint-plugin-mizyind": "^9.0.7",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "guarder",
    "decorator",
    "interceptor",
    "typescript"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "lib"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
